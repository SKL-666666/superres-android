<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮：渐变 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/grad_top"
                android:endColor="@color/grad_bottom"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="55%">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#3DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
