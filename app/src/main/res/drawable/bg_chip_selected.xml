<?xml version="1.0" encoding="utf-8"?>
<!-- 选中 chip：彩色描边 + 略亮的填充 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/glass_fill_sel" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1.4dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
